# Carpeta con los 13 archivos descargados de los portales (ver docs/INSTALACION.md).
# Puede ser relativa a la raíz del proyecto o una ruta absoluta fuera del repositorio.
DENGUE_SOURCE_DIR=Dataset_Dengue

# Territorio de análisis (códigos DIVIPOLA): 76 = Valle del Cauca, 001 = Cali
COD_DEPARTAMENTO=76
COD_MUNICIPIO=001

# Periodo de análisis
ANIO_INICIO=2020
ANIO_FIN=2025

# Semanas previas a la fecha de corte de un archivo que se consideran incompletas
# por el rezago de notificación (en los datos, solo la última semana queda incompleta)
SEMANAS_REZAGO=1

# Canal endémico: años sin epidemia y media ventana (en semanas) para suavizarlo
CANAL_ANIOS_BASE=2021,2022,2025
CANAL_VENTANA=2

# Modelado
RANDOM_STATE=42
TEST_SIZE=0.2
CV_FOLDS=5
ANIO_VALIDACION=2023
ANIO_PRUEBA_INICIO=2024
HORIZONTE_SEMANAS=4
N_REZAGOS=8
N_GRUPOS_COMUNAS=3
